# ══════════════════════════════════════════════════════════════════
#  ÇOX-MÜŞTƏRİLİ (MULTI-TENANT) QURULUŞ
# ══════════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────
# Supabase Dashboard → Settings → API
# Bu, ÇOX-MÜŞTƏRİLİ sxemin qurulduğu baza olmalıdır
# (schema-v3-multitenant.sql işlədilmiş layihə).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGci...   # Service Role Key (secret)

# ── Platforma sahibi (SƏN) ─────────────────────────────
# Yeni müştəri yaratmaq, abunəliyi dayandırmaq, siyahını görmək üçün.
# Heç bir müştəriyə aid deyil — bütün müştərilərin üstündədir.
# Uzun və təsadüfi olsun; boş qalsa platforma API-ləri tamamilə bağlıdır.
PLATFORM_KEY=

# ── Tətbiq ─────────────────────────────────────────────
PORT=3000
# QEYD: ADMIN_KEY ARTIQ İŞLƏDİLMİR.
# Hər müştərinin öz admin açarı var və `auth_keys` cədvəlində saxlanılır
# (`node seed-tenant.js` və ya migrasiya skripti onu yaradır).
# Yalnız `migrate-to-multitenant.js` bu dəyişəni oxuyur — köhnə admin
# açarını yeni bazaya olduğu kimi köçürmək üçün (mövcud linklər sınmasın).
# ADMIN_KEY=

# Konsola çap olunan giriş linklərində işlədilir (yoxdursa localhost)
PUBLIC_URL=https://seninapp.up.railway.app

# Rol yoxlamasını yumşaltmaq üçün ehtiyat qapı. Defolt: icbari.
# DİQQƏT: bu YALNIZ rol yoxlamasına aiddir — müştəri izolyasiyası
# (tdb.js) hər halda işləyir və söndürülə bilməz.
# AUTH_ENFORCE=false

# ── Şəbəkə və qoruma ───────────────────────────────────────
# Neçə əks-proksiyə etibar edilsin. Railway-də 1 (edge proksisi).
# Zəncirdə əlavə qat varsa (məs. Cloudflare) 2 et.
# ⚠️ `true` YAZMA: onda müştərinin özünün göndərdiyi X-Forwarded-For
#    qəbul olunar və filial WiFi yoxlaması saxtalaşdırıla bilər.
# TRUST_PROXY=1

# WiFi yoxlamasının ehtiyat qapısı. Defolt: icbari.
# `false` etsən uyğunsuz IP BLOKLAMIR, sadəcə loga yazılır — yeni filialda
# real IP-ni toplamaq və ya təcili hal üçün. Filial IP-lərini admin panelinin
# «WiFi» tabındakı «Mənim cari IP-m» rəqəmi ilə doldur (o, serverin gördüyü IP-dir).
# WIFI_ENFORCE=false

# Sürət limitini tamamilə söndürür (PIN brute-force qoruması daxil).
# Yalnız limit səhvən iş axınını dayandırsa işlət.
# RATE_LIMIT=false

# ── Push Bildirişlər (VAPID) ────────────────────────────
# Yaratmaq üçün: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ── Yalnız KÖÇÜRMƏ üçün (migrate-to-multitenant.js) ─────
# Köhnə tək-müştərili baza yuxarıdakı SUPABASE_* ilə, yeni baza bunlarla
# göstərilir. Köçürmə bitəndən sonra bunları silmək olar.
# NEW_SUPABASE_URL=
# NEW_SUPABASE_SERVICE_KEY=
# MIGRATE_TENANT_ID=cm
# MIGRATE_TENANT_NAME=Coffeemoon
